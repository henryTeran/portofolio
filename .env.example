# Server only. Configure these in Vercel project environment settings.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=placeholder
SMTP_PASSWORD=placeholder
MAIL_FROM=Henry Teran <hello@example.com>
MAIL_TO=hello@example.com
MAIL_ACKNOWLEDGEMENT=false

# Public widget key only. Set real keys in local/Vercel environments.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_PUBLIC_URL=https://henryteran.com
# Explicit local-only bypass; ignored in production and on Vercel.
VITE_CONTACT_SECURITY_DEV_MODE=false
CONTACT_SECURITY_DEV_MODE=false

# Server-only shared security storage. Empty configuration fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random value of at least 32 characters; never expose it via VITE_.
CONTACT_SECURITY_HASH_SECRET=
